rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() && userDoc().data.role == 'superadmin';
    }

    function isAdminOf(masjidId) {
      return signedIn() && (
        userDoc().data.role == 'superadmin' ||
        (userDoc().data.role == 'admin' && userDoc().data.masjidIds.hasAny([masjidId]))
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /masjids/{masjidId} {
      // Public info about a masjid is readable by everyone.
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();

      // Prayer times are public (homepage) and maintained by admins.
      match /prayerTimes/{date} {
        allow read: if true;
        allow create, update, delete: if isAdminOf(masjidId);
      }

      // Funds and expenses are publicly readable for transparency
      // and written only by admins of that masjid.
      match /funds/{entryId} {
        allow read: if true;
        allow create, update, delete: if isAdminOf(masjidId);
      }

      match /expenses/{entryId} {
        allow read: if true;
        allow create, update, delete: if isAdminOf(masjidId);
      }

      // Events are publicly readable and managed by admins.
      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if isAdminOf(masjidId);
      }

      // Forms are publicly readable so the public can fill them in;
      // only admins may create, edit or delete them.
      match /forms/{formId} {
        allow read: if true;
        allow create, update, delete: if isAdminOf(masjidId);
      }

      // Anyone can submit a form; only admins may read submissions.
      match /formSubmissions/{submissionId} {
        allow create: if true;
        allow read, update, delete: if isAdminOf(masjidId);
      }
    }
  }
}
