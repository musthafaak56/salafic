rules_version = '2';
// Server-controlled center records. Public projections contain no private ledger fields.
// users: uid/name/email/photoURL/createdAt. Roles live ONLY in platformRoles and members.
// Operational writes go through validated callable functions; default deny everywhere else.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function superAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/platformRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformRoles/$(request.auth.uid)).data.role == 'superadmin';
    }
    function memberRole(id) { return get(/databases/$(database)/documents/masjids/$(id)/members/$(request.auth.uid)).data.role; }
    function member(id) {
      return signedIn() && exists(/databases/$(database)/documents/masjids/$(id))
        && exists(/databases/$(database)/documents/masjids/$(id)/members/$(request.auth.uid));
    }
    function staff(id) { return superAdmin() || member(id); }
    function finance(id) { return superAdmin() || (member(id) && memberRole(id) in ['owner','admin','finance']); }
    function editor(id) { return superAdmin() || (member(id) && memberRole(id) in ['owner','admin','editor']); }
    function owner(id) { return superAdmin() || (member(id) && memberRole(id) == 'owner'); }
    function published(id) { return get(/databases/$(database)/documents/masjids/$(id)).data.status == 'published'; }
    function isValidUser(d, uid) {
      return d.keys().hasOnly(['uid','name','email','photoURL','createdAt'])
        && d.keys().hasAll(['uid','name','email','createdAt'])
        && d.uid == uid && d.name is string && d.name.size() <= 120
        && d.email == request.auth.token.email && d.email.size() <= 254
        && d.createdAt is timestamp
        && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 2000));
    }
    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && isValidUser(request.resource.data, uid) && request.resource.data.createdAt == request.time;
      allow update: if self(uid) && isValidUser(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /platformRoles/{uid} { allow read: if self(uid); }
    match /userCenters/{uid}/centers/{id} { allow read: if self(uid); }
    match /centerSlugs/{slug} { allow read: if true; }
    match /centerApplications/{id} { allow read: if superAdmin() || (signedIn() && resource.data.submitterUid == request.auth.uid); }
    match /centerInvitations/{id} { allow read: if superAdmin(); }
    match /masjids/{id} {
      allow read: if resource.data.status == 'published' || staff(id);
      match /members/{uid} { allow read: if self(uid) || owner(id); }
      match /prayerTimes/{date} { allow read: if published(id) || editor(id); }
      match /publicFinance/{doc} { allow read: if published(id) || finance(id); }
      match /publicTransactions/{doc} { allow read: if published(id) || finance(id); }
      match /announcements/{doc} { allow read: if published(id) || editor(id); }
      match /announcementArchive/{doc} { allow read: if editor(id); }
      match /events/{doc} { allow read: if published(id) || editor(id); }
      match /forms/{doc} { allow read: if published(id) || editor(id); }
      match /eventDrafts/{doc} { allow read: if editor(id); }
      match /formDrafts/{doc} { allow read: if editor(id); }
      match /funds/{doc} { allow read: if finance(id); }
      match /expenses/{doc} { allow read: if finance(id); }
      match /financeState/{doc} { allow read: if finance(id); }
      match /formSubmissions/{doc} { allow read: if editor(id); }
      match /contentDrafts/{doc} { allow read: if (resource.data.kind == 'finance' && finance(id)) || (resource.data.kind != 'finance' && editor(id)); }
      match /contentRevisions/{doc} { allow read: if staff(id); }
      match /auditLogs/{doc} { allow read: if owner(id); }
    }
  }
}
